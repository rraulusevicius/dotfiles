{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "reload_style_on_change": true,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window", "custom/close"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/keyboard",
        "pulseaudio",
        "backlight",
        "network",
        "power-profiles-daemon",
        "cpu",
        "temperature",
        "battery",
        "tray",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        // Always show workspaces 1-5, even when empty
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // Built-in hyprland/language doesn't work with the Lua config, so poll via script
    "custom/keyboard": {
        "exec": "~/.config/waybar/keyboard-layout.sh",
        "interval": 1,
        "format": "  {}",
        "tooltip": false,
        "on-click": "hyprctl switchxkblayout all next"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " wired",
        "format-disconnected": " offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5
    },

    "temperature": {
        "format": " {temperatureC}°C",
        "critical-threshold": 85
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "tray": {
        "spacing": 8,
        "reverse-direction": true
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/power-menu.sh"
    },

        "custom/launcher": {
        "format": "󰣇",
        "tooltip-format": "Apps",
        // Toggle: closes fuzzel if it's open, opens it if not
        "on-click": "pkill fuzzel || fuzzel"
    },

    "custom/close": {
        "format": "󰅖",
        "tooltip-format": "Close window",
        "on-click": "hyprctl dispatch 'hl.dsp.window.close()'"
    }
}
